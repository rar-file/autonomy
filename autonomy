#!/bin/bash
# Autonomy v2 — OpenClaw-Native Task Management
# Lightweight, uses native OpenClaw tools

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUTONOMY_DIR="${AUTONOMY_DIR:-$SCRIPT_DIR}"
WORKSPACE="${WORKSPACE:-$(dirname "$AUTONOMY_DIR")}"

# Directories
TASKS_DIR="$AUTONOMY_DIR/tasks"
LOGS_DIR="$AUTONOMY_DIR/logs"
mkdir -p "$TASKS_DIR" "$LOGS_DIR"

# Config
CONFIG="$AUTONOMY_DIR/config.json"
ensure_config() {
    [[ -f "$CONFIG" ]] && return 0
    cat > "$CONFIG" << 'EOF'
{
  "version": "3.0.0",
  "limits": {
    "max_concurrent_tasks": 5,
    "daily_task_budget": 20
  },
  "github": {
    "default_repo": null,
    "notify_on_ci_fail": true
  }
}
EOF
}
ensure_config

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# Disable colors if not terminal
[[ ! -t 1 ]] && { GREEN=''; YELLOW=''; RED=''; BLUE=''; NC=''; }

# Helpers
log() {
    echo -e "${BLUE}[autonomy]${NC} $1"
}

error() {
    echo -e "${RED}[error]${NC} $1" >&2
}

success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

# Task Management
cmd_task() {
    local subcmd="${1:-list}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        create|add)
            local name="${1:-}"
            local desc="${2:-}"
            [[ -z "$name" ]] && { error "Task name required"; return 1; }
            [[ -z "$desc" ]] && read -rp "Description: " desc
            
            local task_file="$TASKS_DIR/${name}.json"
            [[ -f "$task_file" ]] && { error "Task '$name' already exists"; return 1; }
            
            cat > "$task_file" << EOF
{
  "id": "$(date +%s)",
  "name": "$name",
  "description": "$desc",
  "status": "pending",
  "created_at": "$(date -Iseconds)",
  "updated_at": "$(date -Iseconds)",
  "completed_at": null,
  "proof": null
}
EOF
            success "Task '$name' created"
            ;;
            
        list|ls)
            log "Tasks:"
            local count=0
            for task in "$TASKS_DIR"/*.json; do
                [[ -f "$task" ]] || continue
                local name=$(jq -r '.name' "$task")
                local status=$(jq -r '.status' "$task")
                local desc=$(jq -r '.description' "$task" | cut -c1-50)
                local color="${NC}"
                [[ "$status" == "completed" ]] && color="${GREEN}"
                [[ "$status" == "in_progress" ]] && color="${YELLOW}"
                echo -e "  ${color}[$status]${NC} $name: $desc"
                ((count++))
            done
            [[ $count -eq 0 ]] && echo "  No tasks"
            ;;
            
        work|start)
            local name="${1:-}"
            [[ -z "$name" ]] && { error "Task name required"; return 1; }
            local task_file="$TASKS_DIR/${name}.json"
            [[ ! -f "$task_file" ]] && { error "Task '$name' not found"; return 1; }
            
            jq '.status = "in_progress" | .updated_at = "'$(date -Iseconds)'"' "$task_file" > "$task_file.tmp" && mv "$task_file.tmp" "$task_file"
            success "Task '$name' marked as in-progress"
            ;;
            
        complete|done)
            local name="${1:-}"
            local proof="${2:-}"
            [[ -z "$name" ]] && { error "Task name required"; return 1; }
            [[ -z "$proof" ]] && { error "Proof required (what was tested/verified)"; return 1; }
            
            local task_file="$TASKS_DIR/${name}.json"
            [[ ! -f "$task_file" ]] && { error "Task '$name' not found"; return 1; }
            
            jq '.status = "completed" | .completed_at = "'$(date -Iseconds)'" | .proof = "'$proof'" | .updated_at = "'$(date -Iseconds)'"' "$task_file" > "$task_file.tmp" && mv "$task_file.tmp" "$task_file"
            success "Task '$name' completed"
            echo "  Proof: $proof"
            ;;
            
        delete|rm)
            local name="${1:-}"
            [[ -z "$name" ]] && { error "Task name required"; return 1; }
            local task_file="$TASKS_DIR/${name}.json"
            [[ ! -f "$task_file" ]] && { error "Task '$name' not found"; return 1; }
            rm "$task_file"
            success "Task '$name' deleted"
            ;;
            
        *)
            echo "Usage: autonomy task {create|list|work|complete|delete} [args]"
            ;;
    esac
}

# GitHub Integration
cmd_gh() {
    local subcmd="${1:-status}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        prs|pull-requests)
            log "Your open PRs:"
            gh pr list --author @me --state open --json number,title,headRefName,url,createdAt -q '.[] | "  #\(.number) \(.title) [\(.headRefName)]"' 2>/dev/null || echo "  No open PRs"
            ;;
            
        reviews)
            log "PRs waiting for your review:"
            gh pr list --review-requested=@me --state open --json number,title,url -q '.[] | "  #\(.number) \(.title)"' 2>/dev/null || echo "  None"
            ;;
            
        ci-status|checks)
            log "Recent CI status:"
            gh run list --limit 5 --json name,headBranch,conclusion,createdAt -q '.[] | "  \(.conclusion): \(.name) on \(.headBranch)"' 2>/dev/null || echo "  No recent runs"
            ;;
            
        notifications|notifs)
            log "Unread notifications:"
            local count=$(gh api notifications --jq '[.[] | select(.unread)] | length' 2>/dev/null || echo "0")
            [[ "$count" -gt 0 ]] && gh api notifications --jq '.[] | select(.unread) | "  \(.subject.type): \(.subject.title)"' 2>/dev/null | head -10
            [[ "$count" -eq 0 ]] && echo "  No unread notifications"
            ;;
            
        issues)
            log "Recent issues in your repos:"
            gh issue list --author @me --state open --limit 5 --json number,title,url -q '.[] | "  #\(.number) \(.title)"' 2>/dev/null || echo "  No open issues"
            ;;
            
        status)
            echo "GitHub Status:"
            local prs=$(gh pr list --author @me --state open --json number -q 'length' 2>/dev/null || echo "0")
            local reviews=$(gh pr list --review-requested=@me --state open --json number -q 'length' 2>/dev/null || echo "0")
            echo "  Open PRs: $prs"
            echo "  Reviews requested: $reviews"
            ;;
            
        *)
            echo "Usage: autonomy gh {prs|reviews|ci-status|notifications|issues|status}"
            ;;
    esac
}

# VM / System Commands
cmd_vm() {
    local subcmd="${1:-help}"
    shift 2>/dev/null || true
    
    case "$subcmd" in
        process_list|ps)
            ps aux --sort=-%cpu | head -20
            ;;
        top_cpu)
            ps aux --sort=-%cpu | head -10
            ;;
        top_memory)
            ps aux --sort=-%mem | head -10
            ;;
        disk|df)
            df -h
            ;;
        memory|mem)
            free -h
            ;;
        load)
            uptime
            ;;
        docker_ps)
            docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "Docker not available"
            ;;
        docker_images)
            docker images --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}" 2>/dev/null || echo "Docker not available"
            ;;
        service_list)
            systemctl list-units --type=service --state=running 2>/dev/null | head -15 || echo "systemctl not available"
            ;;
        service_status)
            local svc="${1:-}"
            [[ -z "$svc" ]] && { error "Service name required"; return 1; }
            systemctl status "$svc" 2>/dev/null || service "$svc" status 2>/dev/null || echo "Service '$svc' not found"
            ;;
        health)
            echo "System Health:"
            echo "  CPU: $(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)%"
            echo "  Memory: $(free | grep Mem | awk '{printf "%.1f%%", $3/$2 * 100.0}')"
            echo "  Disk: $(df / | tail -1 | awk '{print $5}')"
            echo "  Load: $(uptime | awk -F'load average:' '{print $2}')"
            ;;
        *)
            echo "VM Commands:"
            echo "  process_list, top_cpu, top_memory, disk, memory, load"
            echo "  docker_ps, docker_images"
            echo "  service_list, service_status <service>"
            echo "  health"
            ;;
    esac
}

# Check command (for cron/heartbeat)
cmd_check() {
    local notify=false
    [[ "$1" == "--notify" ]] && notify=true
    
    local issues=()
    
    # Check pending tasks
    local pending=$(ls -1 "$TASKS_DIR"/*.json 2>/dev/null | while read f; do jq -r 'select(.status == "pending") | .name' "$f"; done | wc -l)
    [[ $pending -gt 0 ]] && issues+=("$pending pending tasks")
    
    # Check GitHub notifications
    local notifs=$(gh api notifications --jq '[.[] | select(.unread)] | length' 2>/dev/null || echo "0")
    [[ $notifs -gt 0 ]] && issues+=("$notifs GitHub notifications")
    
    # Check CI failures
    local failed_ci=$(gh run list --status failure --limit 5 --json conclusion -q 'length' 2>/dev/null || echo "0")
    [[ $failed_ci -gt 0 ]] && issues+=("$failed_ci failed CI runs")
    
    if [[ ${#issues[@]} -gt 0 ]]; then
        log "Issues found:"
        for issue in "${issues[@]}"; do
            echo "  • $issue"
        done
        $notify && echo "[autonomy] ${#issues[@]} issues need attention: ${issues[*]}"
    else
        log "All clear"
    fi
}

# Main dispatch
cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    task|tasks)
        cmd_task "$@"
        ;;
    gh|github)
        cmd_gh "$@"
        ;;
    vm|system)
        cmd_vm "$@"
        ;;
    check)
        cmd_check "$@"
        ;;
    help|--help|-h)
        echo "Autonomy v2 — OpenClaw-Native Task Management"
        echo ""
        echo "Commands:"
        echo "  task {create|list|work|complete|delete}  Task management"
        echo "  gh {prs|reviews|ci-status|notifications}   GitHub integration"
        echo "  vm {process_list|health|docker_ps|...}     System monitoring"
        echo "  check [--notify]                           Check for issues"
        echo ""
        echo "Examples:"
        echo "  autonomy task create 'fix-auth' 'Fix login bug'"
        echo "  autonomy gh prs"
        echo "  autonomy vm health"
        ;;
    *)
        error "Unknown command: $cmd"
        echo "Run 'autonomy help' for usage"
        exit 1
        ;;
esac
